{
  "name": "decky-dlssnr-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reversible local DLSSNR-ReShade installs for Steam games from Decky Loader.",
  "scripts": {
    "build": "rollup -c",
    "package": "bash scripts/package-plugin.sh",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "pnpm": { "peerDependencyRules": { "ignoreMissing": ["react", "react-dom"] } }
}
